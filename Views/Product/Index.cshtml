@model List<ProductCatalog.Models.Product>

<!DOCTYPE html>
<html>
<head>
    <title>Product Catalog</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                background-color: #f5f5f5;
                margin: 0;
                padding: 30px;
            }

            h1 {
                text-align: center;
                margin-bottom: 30px;
            }

            .products {
                display: flex;
                justify-content: center;
                gap: 20px;
                flex-wrap: wrap;
            }

            .product-card {
                background-color: white;
                width: 220px;
                padding: 15px;
                border-radius: 8px;
                text-align: center;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
            }

            .product-card img {
                width: 180px;
                height: 150px;
                object-fit: contain;
            }

            .product-card h2 {
                font-size: 20px;
                margin: 10px 0;
            }

            .product-card p {
                margin: 7px 0;
            }

            .price {
                font-weight: bold;
                font-size: 18px;
            }
    </style>
</head>

<body>

    <h1>Product Catalog</h1>

    <div class="products">

        @foreach (var product in Model)
        {
            <div class="product-card">

                <img src="~/images/@product.Image"
                     alt="@product.Name" />

                <h2>@product.Name</h2>

                <p>Category: @product.Category</p>

                <p class="price">₹@product.Price</p>

            </div>
        }

    </div>

</body>
</html>